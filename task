# Step 1: Create an Ubuntu VM and clone it using VirtualBox (Full Clone)

# Step 2: Update Ubuntu
sudo apt update

# Step 3: Install Cron
sudo apt install cron -y

# Step 4: Enable and start Cron
sudo systemctl enable --now cron
sudo systemctl status cron 

# Step 5: Create the script
nano script.sh

#!/bin/bash
echo "Hello"


# Step 6: Save the file using Ctrl+O, Enter, Ctrl+X

# Step 7: Make the script executable
chmod +x ~/script.sh

# Step 8: Open the Cron scheduler
crontab -e

** * * * $HOME/script.sh >> $HOME/output.log 2>&1

# Step 9: Save using Ctrl+O, Enter, Ctrl+X

# Step 10: Wait one minute and check the output
cat ~/output.log

# Step 11: Check Cron status
systemctl status cron
